{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Silent Static: all domains",
            "type": "debugpy",
            "request": "launch",
            "module": "silent_static.cli",
            "cwd": "${workspaceFolder}/tech/silent-static",
            "console": "integratedTerminal"
        },
        {
            "name": "Silent Static: selected domain",
            "type": "debugpy",
            "request": "launch",
            "module": "silent_static.cli",
            "cwd": "${workspaceFolder}/tech/silent-static",
            "args": [
                "${input:silentStaticDomain}"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Silent Static: run tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
                "-v"
            ],
            "cwd": "${workspaceFolder}/tech/silent-static",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "silentStaticDomain",
            "type": "pickString",
            "description": "Choose a creative domain",
            "options": [
                "music",
                "film",
                "art",
                "tech",
                "sports"
            ],
            "default": "tech"
        }
    ]
}
